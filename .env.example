# Port, auf dem der Server lauscht
PORT=3000
# Interface (0.0.0.0 = alle Netzwerke, 127.0.0.1 = nur lokal, z. B. hinter Reverse-Proxy)
HOST=0.0.0.0
# Speicherort für Datenbank & Schlüssel
DATA_DIR=./data
# Hinter Reverse-Proxy (Nginx, Caddy, Synology, Nginx Proxy Manager): true
TRUST_PROXY=false
# Secure-Cookies erzwingen (true) / abschalten (false). Leer = automatisch
COOKIE_SECURE=
# Zeitzone für Companion-Textwerte
TZ=Europe/Berlin
