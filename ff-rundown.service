# Linux-Dienst (systemd). Pfade anpassen, dann:
#   sudo cp ff-rundown.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now ff-rundown
[Unit]
Description=FF Rundown
After=network.target

[Service]
Type=simple
User=rundown
WorkingDirectory=/opt/ff-rundown
Environment=PORT=3000
Environment=DATA_DIR=/opt/ff-rundown/data
Environment=TZ=Europe/Berlin
ExecStart=/usr/bin/node --no-warnings server/index.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
